# WhatsApp Bot Control Panel - Apache Configuration

# ============================================================================
# Security Headers
# ============================================================================

# Prevent directory listing
Options -Indexes

# Disable server signature
ServerTokens Prod
ServerSignature Off

# ============================================================================
# Redirect HTTP to HTTPS (production only)
# ============================================================================
# Uncomment in production:
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================================================
# Security Headers
# ============================================================================
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Enable XSS protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Content Security Policy (basic)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
</IfModule>

# ============================================================================
# URL Rewriting
# ============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Prevent access to includes directory
    RewriteRule ^includes/ - [F]
    
    # Prevent access to config file
    RewriteRule ^config\.php - [F]
    
    # Prevent access to database directory
    RewriteRule ^database/ - [F]
    
    # Prevent access to logs directory
    RewriteRule ^logs/ - [F]
    
    # Prevent access to temp directory
    RewriteRule ^temp/ - [F]
    
    # Prevent access to uploads temp directory
    RewriteRule ^uploads/temp/ - [F]
    
    # Prevent access to hidden files
    RewriteRule "^\." - [F]
    
    # Prevent access to backup files
    RewriteRule "\.(bak|backup|backup\.sql|\.sql)$" - [F]
    
    # API routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/v1/(.*)$ api/v1/index.php [L,QSA]
</IfModule>

# ============================================================================
# File Type Restrictions
# ============================================================================

# Prevent execution of scripts in uploads directory
<Directory "uploads">
    php_flag engine off
    AddType text/plain .php .phtml .php3 .php4 .php5 .php6 .phps .pht .phar
    <FilesMatch "\.(php|phtml|php3|php4|php5|php6|phps|pht|phar)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</Directory>

# Prevent execution of scripts in temp directory
<Directory "temp">
    php_flag engine off
    <FilesMatch "\.(php|phtml|php3|php4|php5|php6|phps|pht|phar)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</Directory>

# ============================================================================
# Compression
# ============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================================================
# Caching
# ============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Cache static assets
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/css "access plus 1 week"
    
    # Don't cache HTML
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ============================================================================
# Session Security
# ============================================================================
<IfModule mod_php.c>
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 0
    php_value session.cookie_samesite "Strict"
    php_value session.use_only_cookies 1
    php_value session.sid_length 32
    php_value session.sid_bits_per_character 6
</IfModule>
